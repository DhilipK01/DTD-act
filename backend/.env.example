PORT=5000
JWT_SECRET=super_secret_jwt_key_expense_tracker_change_in_prod
OTP_SECRET=secure_otp_salt_secret_key_change_in_prod
NODE_ENV=development
CLIENT_URL=https://your-frontend-app.vercel.app

# MongoDB Connection URI (e.g. MongoDB Atlas cluster or local MongoDB):
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/dtd_expenses?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/dtd_expenses

# Optional SMTP configuration for live Nodemailer sending (e.g. Gmail App Password)
# If left commented or blank, OTPs will print to console and appear in dev UI preview!
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@gmail.com
# SMTP_PASS=your-google-app-password
# SMTP_FROM=your-email@gmail.com
